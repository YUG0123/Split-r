# Convex — generated automatically the first time you run `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — from your Clerk dashboard (Configure > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# Resend — from resend.com/api-keys, used for payment reminder emails
RESEND_API_KEY=

# Google Gemini — from aistudio.google.com/app/apikey, used for spending insights
GEMINI_API_KEY=
